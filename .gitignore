# Data never lives in the repo (Dataset_ALL is on each machine; see DATA_ROOT in config.yaml)
Dataset_ALL/
*.set
*.fdt
*.mat
*.fif
*.npy
*.h5

# Results: git-ignored except small CSVs and figures
results/**
!results/**/
!results/**/.gitkeep
!results/features/*.csv
!results/figures/*
# Microstate templates (derived maps, no EEG): downloadable for teammates (Oct 23)
!results/templates/*.fif

# Python / notebooks
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.DS_Store
